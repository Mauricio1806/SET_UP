# ============================================================
# SET_UP — variáveis de ambiente
# Copie para .env e preencha
# ============================================================

# ----------------------------------------------------------
# NOTION
# 1. notion.so/my-integrations → New integration → Internal
# 2. Capabilities: Read + Insert content
# 3. No hub Spain Digital Nomad: ... → Add connections → SET_UP
# ----------------------------------------------------------
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_HUB_ID=3736d7bcf70c81c09c0ff224c550e309

# ----------------------------------------------------------
# IDEALISTA — Opção A: API oficial (melhor, 100 req/dia grátis)
# → developers.idealista.com → Request API key (~24-72h)
# ----------------------------------------------------------
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=

# ----------------------------------------------------------
# IDEALISTA — Opção B: ZenRows JS render (imediato, free tier)
# 1. Você já tem conta em zenrows.com
# 2. Dashboard → API Key → copiar aqui
# 3. Custo: ~5 créditos/request (free tier = 1000 créditos)
#    = ~200 requests com JS render grátis
# ----------------------------------------------------------
ZENROWS_KEY=

# Câmbio EUR/BRL (atualizar quando mudar)
EUR_BRL_RATE=5.90
